#!/bin/zsh
set -euo pipefail

SCRIPT_DIR=${0:A:h}
PROJECT_ROOT=${SCRIPT_DIR:h}
CACHE_ROOT="$PROJECT_ROOT/.codex-cache"
CLANG_CACHE="$CACHE_ROOT/clang"
SWIFTPM_CACHE="$CACHE_ROOT/swiftpm"
SCRATCH_PATH="$CACHE_ROOT/maestrocli-build"
PACKAGE_PATH="$SCRIPT_DIR/MaestroCLI"
BINARY_PATH="$SCRATCH_PATH/debug/MaestroCLI"

mkdir -p "$CLANG_CACHE" "$SWIFTPM_CACHE" "$SCRATCH_PATH"

export CLANG_MODULE_CACHE_PATH="$CLANG_CACHE"
export SWIFTPM_MODULECACHE_OVERRIDE="$SWIFTPM_CACHE"
export XDG_CACHE_HOME="$CACHE_ROOT/xdg"

needs_build=0
if [[ ! -x "$BINARY_PATH" ]]; then
  needs_build=1
elif [[ -n "$(find "$PACKAGE_PATH" \( -path '*/Sources/*' -o -name 'Package.swift' \) -type f -newer "$BINARY_PATH" -print -quit)" ]]; then
  needs_build=1
fi

if (( needs_build )); then
  swift build \
    --disable-sandbox \
    --package-path "$PACKAGE_PATH" \
    --scratch-path "$SCRATCH_PATH" \
    >/dev/null
fi

exec "$BINARY_PATH" "$@"
